{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devweave.org/schemas/work-item.schema.json",
  "title": "WorkItem",
  "type": "object",
  "required": ["work_item_id", "title", "type", "status", "priority", "source", "created_at"],
  "properties": {
    "work_item_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["UserStory", "Bug", "Task", "Feature", "Epic", "ModernizationUnit", "Requirement", "TechnicalDebt", "Custom"]
    },
    "status": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": ["Highest", "High", "Medium", "Low", "Lowest", "Critical", "Normal", "Minor"]
    },
    "assignee": {
      "type": "string"
    },
    "reporter": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "iteration": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["jira", "azure-devops", "github", "linear", "custom", "manual"]
        },
        "url": { "type": "string" },
        "project": { "type": "string" },
        "key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "author", "created_at", "text"],
        "properties": {
          "id": { "type": "string" },
          "author": { "type": "string" },
          "created_at": { "type": "string" },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "filename", "category"],
        "properties": {
          "id": { "type": "string" },
          "filename": { "type": "string" },
          "content_type": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "category": {
            "type": "string",
            "enum": ["TEXT", "DOCUMENT", "IMAGE", "ARCHIVE", "OTHER"]
          },
          "extracted_text": { "type": "string" },
          "ocr_status": {
            "type": "string",
            "enum": ["SUCCESS", "PARTIAL", "FAILED", "NOT_APPLICABLE"]
          },
          "ocr_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "evidence_reference": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "linked_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "relationship", "title"],
        "properties": {
          "id": { "type": "string" },
          "relationship": {
            "type": "string",
            "enum": ["blocks", "depends-on", "relates-to", "child-of", "parent-of", "duplicate-of", "migrated-from"]
          },
          "title": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "related_historical_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "relevance_reason"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "relevance_reason": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "provider_metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
