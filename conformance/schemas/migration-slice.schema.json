{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devweave.org/schemas/migration-slice.schema.json",
  "title": "MigrationSlice",
  "type": "object",
  "required": ["work_item_id", "modernization_unit", "legacy_components", "generated_at"],
  "properties": {
    "work_item_id": {
      "type": "string"
    },
    "modernization_unit": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["PAGE", "SCREEN", "FEATURE", "MODULE", "SERVICE", "DOMAIN", "WORKFLOW", "API", "TRANSACTION", "COMPONENT", "CAPABILITY", "CUSTOM"]
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "legacy_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "layer", "role"],
        "properties": {
          "path": { "type": "string" },
          "layer": {
            "type": "string",
            "enum": ["UI", "Controller", "Service", "BusinessRule", "Model", "Database", "Config", "Integration", "Test"]
          },
          "role": { "type": "string" },
          "line_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "database_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["TABLE", "VIEW", "STORED_PROCEDURE", "FUNCTION", "TRIGGER", "INDEX", "MIGRATION"]
          },
          "operations": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "test_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "framework", "test_count"],
        "properties": {
          "path": { "type": "string" },
          "framework": { "type": "string" },
          "test_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "external_integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "protocol"],
        "properties": {
          "name": { "type": "string" },
          "protocol": { "type": "string" },
          "direction": {
            "type": "string",
            "enum": ["INBOUND", "OUTBOUND", "BIDIRECTIONAL"]
          }
        },
        "additionalProperties": false
      }
    },
    "bounded_graph_nodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "slice_token_estimate": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
