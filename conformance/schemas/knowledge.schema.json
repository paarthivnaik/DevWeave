{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devweave.org/schemas/knowledge.schema.json",
  "title": "KnowledgeItem",
  "type": "object",
  "required": ["id", "type", "title", "description", "domain", "source", "evidence", "confidence", "status", "last_verified"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KB-[A-Z]{3,}-[0-9]{3,}$"
    },
    "type": {
      "type": "string",
      "enum": ["architecture", "domain", "technical", "convention", "security"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "domain": { "type": "string" },
    "source": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": ["OBSERVED", "INFERRED", "RECOMMENDED", "APPROVED", "DEPRECATED"]
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "approved_by": { "type": "string" }
  },
  "additionalProperties": false
}
